# Скопируй этот файл в .env и заполни своими значениями
# .env НИКОГДА не должен попасть в git (он уже в .gitignore)

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=сюда_вставь_свой_токен

# Твой Telegram ID (узнать через @userinfobot) - на этапе MVP бот шлёт сигналы только тебе
ADMIN_TELEGRAM_ID=сюда_вставь_свой_id

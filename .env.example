# Скопируй этот файл в .env и заполни своими значениями
# .env НИКОГДА не должен попасть в git (он уже в .gitignore)

# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=сюда_вставь_токен_бота

# Твой Telegram ID (узнать через @userinfobot)
ADMIN_TELEGRAM_ID=сюда_вставь_свой_id

# ── База данных ───────────────────────────────────────────────────────────────
# По умолчанию SQLite, можно заменить на PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///bot.db

# ── Оплата через @CryptoBot ───────────────────────────────────────────────────
# Токен из @CryptoBot → Apps → Create App
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api

# ── Авто-трейдер ──────────────────────────────────────────────────────────────
# Включить автоматическую торговлю при старте (true/false)
TRADER_ENABLED=false

# Размер одной сделки в USDT
TRADER_AMOUNT_USD=200

# Минимальный чистый профит для исполнения (%)
TRADER_MIN_PROFIT_PCT=1.5

# Максимум сделок в день (защита от сбоев)
TRADER_MAX_DAILY_TRADES=10

# Максимальный дневной убыток в USDT (стоп-лосс)
TRADER_MAX_DAILY_LOSS_USD=100

# Bybit — https://www.bybit.com/app/user/api-management
# Права: Read + Trade (только Spot, вывод НЕ нужен для pre-funded модели)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Binance — https://www.binance.com/en/my/settings/api-management
# Права: Enable Spot & Margin Trading
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX — https://www.okx.com/account/my-api
# Права: Read + Trade
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
